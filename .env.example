# Copy to .env (same folder as docker-compose.yml) and fill in.
# Variables used by docker-compose AND the backend.

DB_USER=postgres
DB_PASSWORD=CHANGE_ME_long_random
DB_NAME=ELSA_BEAUTY

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=CHANGE_ME

# app + landing (the landing page posts demo sign-ups to the API)
CORS_ORIGINS=https://app.elsaerp.com,https://www.app.elsaerp.com,https://elsaerp.com,https://www.elsaerp.com
TRUST_PROXY=1

MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

DEMO_URL=https://app.elsaerp.com
DEMO_TEMPLATE_SCHEMA=demo_template
DEMO_PLAN_CODE=pro

OPENROUTER_API_KEY=
APP_URL=https://app.elsaerp.com
