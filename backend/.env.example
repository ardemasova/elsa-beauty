# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=ELSA_BEAUTY
# PG_POOL_MAX=10

# --- Security ---
# At least 32 random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=CHANGE_ME
# ACCESS_TOKEN_TTL=12h
# Frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (nginx = 1)
# TRUST_PROXY=1

PORT=3000
NODE_ENV=development

# --- Email (Namecheap Private Email) ---
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# MAIL_DEBUG=true      # prints the full SMTP dialogue, only for troubleshooting
# MAIL_TRANSPORT=json  # local development: do not send real emails

# --- Demo sign-up ---
DEMO_URL=https://app.elsaerp.com
DEMO_TEMPLATE_SCHEMA=salon_demo
DEMO_PLAN_CODE=pro

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
APP_URL=https://app.elsaerp.com
